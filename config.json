{
  "$schema": "https://www.getbifrost.ai/schema",
  "tenant_store": {
    "enabled": true,
    "refresh_interval_seconds": 10,
    "max_idle_conns": 2,
    "max_open_conns": 10,
    "global": {
      "host": "localhost",
      "port": "5432",
      "user": "postgres",
      "password": "monetize360",
      "db_name": "mpilotv2",
      "ssl_mode": "disable",
      "max_idle_conns": 2,
      "max_open_conns": 10
    },
    "jwt_public_key": "",
    "admin_jwt_public_key": ""
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres"
  },
  "vector_store": {
    "enabled": true,
    "type": "weaviate",
    "config": {
      "scheme": "http",
      "host": "localhost:9000"
    }
  },
  "plugins": [
    {
      "name": "governance",
      "enabled": true,
      "config": {
        "semantic_routing": {
          "enabled": true,
          "default_for_all": true,
          "default_class": "Other",
          "router": {
            "base_url": "http://127.0.0.1:18080",
            "preview_path": "/api/v1/routing/preview",
            "entrypoint": "vllm-sr/auto",
            "timeout_ms": 2000
          },
          "task_weight": 1.0,
          "tier_weight": 1.0,
          "preference_weight": 0.5,
          "cost_weight": 0.5,
          "context_weight": 0.2,
          "model_overrides_file": "/Users/abhishekdixit/Documents/ApplicationCode/ai-gateway/plugins/governance/poc/gemini-model-routing.json",
          "classes": {
            "Code Generation": [
              "gemini/gemini-2.5-pro",
              "gemini/gemini-2.5-flash",
              "gemini/gemini-2.0-flash"
            ],
            "Open QA": [
              "gemini/gemini-2.5-flash-lite",
              "gemini/gemini-2.5-flash",
              "gemini/gemini-2.0-flash"
            ],
            "Summarization": [
              "gemini/gemini-2.5-flash-lite",
              "gemini/gemini-2.5-flash",
              "gemini/gemini-2.0-flash"
            ],
            "Other": [
              "gemini/gemini-2.5-flash-lite",
              "gemini/gemini-2.0-flash",
              "gemini/gemini-2.5-flash",
              "gemini/gemini-2.5-pro"
            ]
          }
        }
      }
    }
  ]
}
