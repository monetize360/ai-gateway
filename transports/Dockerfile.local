# Dockerfile.local - Uses local module sources via go workspace
# For pre-release CI builds where module versions aren't published yet
#
# The in-process semantic-router plugin links Rust shared libraries via CGO, so
# this image is glibc (Debian) and dynamically linked; musl static linking cannot
# consume the .so files.

  # --- Native Stage: Semantic Router Rust libraries (CPU-only, mirrors upstream `make rust-ci`) ---
  FROM rust:1.90-bookworm AS native-builder
  WORKDIR /build/semantic-router

  # cmake: onnx-binding's turbojpeg-sys build script
  RUN apt-get update && apt-get install -y --no-install-recommends cmake && \
    rm -rf /var/lib/apt/lists/*

  COPY semantic-router/candle-binding/ ./candle-binding/
  RUN cd candle-binding && cargo build --release --no-default-features
  COPY semantic-router/ml-binding/ ./ml-binding/
  RUN cd ml-binding && cargo build --release
  COPY semantic-router/nlp-binding/ ./nlp-binding/
  RUN cd nlp-binding && cargo build --release
  COPY semantic-router/onnx-binding/ ./onnx-binding/
  RUN cd onnx-binding && cargo build --release --lib --locked --no-default-features --features dynamic

  RUN mkdir -p /out && \
    cp candle-binding/target/release/libcandle_semantic_router.so \
      ml-binding/target/release/libml_semantic_router.so \
      nlp-binding/target/release/libnlp_binding.so \
      onnx-binding/target/release/libonnx_semantic_router.so \
      /out/

  # --- Go Build Stage: Compile the Go binary using local modules ---
  FROM golang:1.26.2-bookworm@sha256:47ce5636e9936b2c5cbf708925578ef386b4f8872aec74a67bd13a627d242b19 AS builder
  WORKDIR /build

  RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev && \
    rm -rf /var/lib/apt/lists/*

  # Set environment for CGO-enabled build (required for go-sqlite3 and semantic-router)
  ENV CGO_ENABLED=1 GOOS=linux

  # Copy all local modules
  COPY core/ ./core/
  COPY framework/ ./framework/
  COPY plugins/ ./plugins/
  COPY transports/ ./transports/
  COPY semantic-router/ ./semantic-router/

  # CGO directives link against <binding>/target/release relative to each binding.
  COPY --from=native-builder /out/libcandle_semantic_router.so ./semantic-router/candle-binding/target/release/
  COPY --from=native-builder /out/libml_semantic_router.so ./semantic-router/ml-binding/target/release/
  COPY --from=native-builder /out/libnlp_binding.so ./semantic-router/nlp-binding/target/release/
  COPY --from=native-builder /out/libonnx_semantic_router.so ./semantic-router/onnx-binding/target/release/

  # Set up go workspace to resolve local module dependencies.
  # plugins/semanticrouter reaches semantic-router through path-only replaces,
  # which only resolve when those modules are workspace members.
  RUN go work init && \
    go work use ./core && \
    go work use ./framework && \
    go work use ./plugins/compat && \
    go work use ./plugins/governance && \
    go work use ./plugins/jsonparser && \
    go work use ./plugins/kafka && \
    go work use ./plugins/logging && \
    go work use ./plugins/maxim && \
    go work use ./plugins/mocker && \
    go work use ./plugins/otel && \
    go work use ./plugins/prompts && \
    go work use ./plugins/semanticcache && \
    go work use ./plugins/semanticrouter && \
    go work use ./plugins/telemetry && \
    go work use ./semantic-router/candle-binding && \
    go work use ./semantic-router/ml-binding && \
    go work use ./semantic-router/nlp-binding && \
    go work use ./semantic-router/onnx-binding && \
    go work use ./semantic-router/src/semantic-router && \
    go work use ./transports


  # Build the binary with CGO enabled (dynamically linked against the native libraries)
  ARG VERSION=unknown
  RUN cd /build/transports && \
    go build \
      -ldflags="-w -s -X main.Version=v${VERSION}" \
      -a -trimpath \
      -tags "sqlite_static" \
      -o /app/main \
      ./bifrost-http

  # Verify build succeeded
  RUN test -f /app/main || (echo "Build failed" && exit 1)

  # --- Runtime Stage: Minimal runtime image ---
  FROM debian:bookworm-slim
  WORKDIR /app

  # ca-certificates: For HTTPS connections
  # wget: container health check
  RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget && \
    rm -rf /var/lib/apt/lists/*

  # Create data directory and set up user
  COPY --from=builder /app/main .
  COPY --from=builder /build/transports/docker-entrypoint.sh .
  COPY --from=native-builder /out/ /app/lib/
  ENV LD_LIBRARY_PATH=/app/lib

  # Fail the image build if any shared library is unresolved.
  RUN ! ldd /app/main /app/lib/*.so | grep "not found"

  # Getting arguments
  ARG ARG_APP_PORT=8080
  ARG ARG_APP_HOST=0.0.0.0
  ARG ARG_LOG_LEVEL=info
  ARG ARG_LOG_STYLE=json
  ARG ARG_APP_DIR=/app/data

  # Environment variables with defaults (can be overridden at runtime)
  ENV APP_PORT=$ARG_APP_PORT \
    APP_HOST=$ARG_APP_HOST \
    LOG_LEVEL=$ARG_LOG_LEVEL \
    LOG_STYLE=$ARG_LOG_STYLE \
    APP_DIR=$ARG_APP_DIR


  RUN mkdir -p "$APP_DIR/logs" && \
    useradd -m -s /bin/sh appuser && \
    chown -R appuser:appuser /app && \
    { [ "$APP_DIR" = "/app" ] || [ "${APP_DIR#/app/}" != "$APP_DIR" ] || chown -R appuser:appuser "$APP_DIR"; } && \
    chmod +x /app/docker-entrypoint.sh
  USER appuser


  # Declare volume for data persistence
  VOLUME ["${APP_DIR}"]
  EXPOSE $APP_PORT

  # Health check for container status monitoring
  HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 -O /dev/null http://127.0.0.1:${APP_PORT}/health || exit 1

  # Use entrypoint script that handles volume permissions and argument processing
  ENTRYPOINT ["/app/docker-entrypoint.sh"]
  CMD ["/app/main"]
